phoneme E2
  vwl  starttype #e  endtype #e
  length 80
  IF nextVowel(isMaxStress) THEN
    IF prevPh(j) THEN
      ChangePhoneme(I3)
    ELSE
      ChangePhoneme(E#)
    ENDIF
  ENDIF

  IF thisPh(isMaxStress) THEN
    IF prevPhW(j) THEN
