phoneme ja
  vwl  starttype #i endtype #a

  // Логика редукции для безударных позиций
  IF NOT thisPh(isMaxStress) THEN

    // В конце слова ja
    IF thisPh(isWordEnd) THEN

    // 1. Перед ударением (японец, язык)
    ELIF nextVowel(isMaxStress) THEN
      ChangeIfUnstressed(jI)

    // 2. после ударения
    ELIF thisPh(isAfterStress) THEN

      // Последний слог в слове
      IF thisPh(isFinalVowel) THEN
        // Оставляем ja
        IF nextPh(t) THEN
          // строят
        ELIF nextPh(s;) THEN
          // нагибаясь
        ELIF nextPh(m) THEN
          // кривляниям
        ELIF nextPh(x) THEN
          // песнях
        ELSE
          // Все остальные заударные (заяц, пояс) -> Иканье
          ChangeIfUnstressed(jI)
        ENDIF

      // Предпоследний слог
      ELIF nextVowel(isFinalVowel) THEN
        // Оставляем ja
        IF nextPh(ts) THEN
          // -тся -ться  ( см. замены для т в ru_rules)
        ELIF nextPh(s;) THEN
          // переодевшаяся
        ELIF nextPh(m;) THEN
          // змеями
        ELSE
          ChangeIfUnstressed(jI) // (выяснить)
        ENDIF

      ELSE
        // Прочие заударные позиции
        ChangeIfUnstressed(jI)
      ENDIF

    ELSE
      // 2-й и 3-й предударные слоги
      ChangeIfUnstressed(jI)
    ENDIF
  ENDIF

  IF thisPh(isMaxStress) THEN
    length 200
    FMT(vwl_ru/ja)
  ELSE
    FMT(vdiph2/ii@)
  ENDIF
endphoneme


