// Palatalized versions of consonants

phoneme I^ // "silent i", palatilizes the preceding consonant
  vwl starttype #i endtype #i
  unstressed nsy
  length 70
  IF nextPh(isVowel) THEN
    ChangePhoneme(;)
  ENDIF
  IF prevPh(m;) THEN
    FMT(vwl_ro/mi)
  ENDIF
  FMT(vwl_ru/ii-)
endphoneme


//*******************************************************************
// VOWELS
//*******************************************************************


phoneme i
  IF prevPh(Z) THEN
    ChangePhoneme(y)
  ENDIF

  // Если звук НЕ ударный
  IF NOT thisPh(isMaxStress) THEN
    // Сначала проверяем на [j]
    IF nextPh(j) THEN
       ChangePhoneme(I)    // Перед 'й' редуцируем!
    // Потом проверяем на остальные мягкие
    ELIF nextPh(isPalatal) THEN
       // Оставляем i (перед мягкими согласными)
    ELSE
       ChangePhoneme(I)    // Перед твёрдыми редуцируем
    ENDIF
  ENDIF

  vwl starttype #i endtype #i
  length 50
  FMT(vwl_ru/ii)
endphoneme


phoneme I#
  vwl starttype #i endtype #i
  length 80
  IF nextVowel(isMaxStress) THEN
    ChangePhoneme(I)
  ENDIF
  IF thisPh(isMaxStress) THEN
    ChangePhoneme(i)
  ENDIF
  FMT(vwl_ru/ii#)
endphoneme


phoneme y
  vwl starttype #i endtype #i
  ipa ɨ
  length 100
  FMT(vwl_ru/i#)
endphoneme


phoneme I
  vwl starttype #i endtype #i
  length 80
  FMT(vwl_ru/ii)
endphoneme


phoneme I2
  vwl starttype #i endtype #i
  length 80

  // Если на эту финальную 'и' падает ударение (такси, шасси)
  IF thisPh(isMaxStress) THEN
    ChangePhoneme(i)
  ENDIF

  // Если ударения нет (танки, кошки), используется I
  FMT(vwl_ru/ii)
endphoneme


phoneme I3
  vwl starttype #i endtype #i
  length 80
  IF thisPh(isMaxStress) THEN
    IF prevPhW(j) THEN
      ChangePhoneme(e)
    ELSE
      ChangePhoneme(ja)
    ENDIF
  ENDIF
  IF prevPhW(isPalatal) THEN
    ChangePhoneme(I)
  ENDIF
  FMT(vwl_ru/ii)
endphoneme


