phoneme a
  vwl   starttype #a  endtype #a
  length 100

  // 1. Исключение для звука [j]
  IF prevPhW(j) THEN
    // Ничего не делаем, пропускаем к финальному FMT
  ELSE
    
    // 2. УДАРНАЯ ПОЗИЦИЯ (выбор между глубоким 'A' и мягким 'a')
    IF thisPh(isMaxStress) THEN
      IF prevPhW(isPalatal) THEN
        ChangePhoneme(a)
      ELSE
        ChangePhoneme(A)
      ENDIF
      
    // 3. БЕЗУДАРНАЯ ПОЗИЦИЯ
    ELSE
      IF prevPhW(isPalatal) THEN
        
        // ПЕРВЫЙ ПРЕДУДАРНЫЙ СЛОГ (пятак, часы)
        IF nextVowel(isMaxStress) THEN
          ChangePhoneme(I)
          
        // После ударения)
        ELIF thisPh(isAfterStress) THEN

          // Последний гласный
          IF thisPh(isFinalVowel) THEN
            IF nextPh(t) THEN
              ChangePhoneme(V)     // -ят (исходят)
            ELIF nextPh(s;) THEN
              ChangePhoneme(V)     // -ясь (нагибаясь)
            ELIF nextPh(m) THEN
              ChangePhoneme(V)     // -ям (полям)
            ELIF nextPh(x) THEN
              ChangePhoneme(V)     // -ях (песнях)
            ELSE
              ChangePhoneme(I)     // память, витязь, месяц
            ENDIF

          // Предпоследний гласный
          ELIF nextVowel(isFinalVowel) THEN
            IF nextPh(ts) THEN
              ChangePhoneme(V)     // -ятся (строятся, видятся)
            ELIF nextPh(m;) THEN
              ChangePhoneme(V)     // -ями (пулями)
            ELSE
              ChangePhoneme(I)     // выяснить, пояснить
            ENDIF

          ELSE
            // Все прочие заударные позиции
            ChangePhoneme(I)
          ENDIF
          
        ELSE
          // 2-й и 3-й предударные слоги (пятачок)
          ChangePhoneme(I)
        ENDIF
        
      ENDIF // конец блока isPalatal
    ENDIF // конец безударного блока
  ENDIF // конец блока исключения j

  IF thisPh(isWordEnd) THEN
    FMT(vowel/a#_3)
  ENDIF
  FMT(vwl_ru/aa)
endphoneme


